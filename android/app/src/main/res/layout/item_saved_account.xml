<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardAccount"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeWidth="1.5dp"
    app:strokeColor="@color/card_stroke"
    app:cardBackgroundColor="@color/card_bg"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Selected indicator (radio icon / check) -->
        <ImageView
            android:id="@+id/ivSelectRadio"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@android:drawable/radiobutton_off_background"
            app:tint="@color/text_secondary"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAccountPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0505 123 45 67"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvAccountStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Şifre kayıtlı • Seçmek için dokun"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Delete button -->
        <ImageButton
            android:id="@+id/btnDeleteAccount"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/error"
            android:contentDescription="Hesabı Sil" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
